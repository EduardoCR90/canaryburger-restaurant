# Explicit instance identity. No source project IDs are embedded in shared code.
SITE_URL=https://restaurant.example
SITE_BASE=/
SANITY_USE_MOCK=true
# Required in CMS mode; configure the restaurant's own project.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Build-only private read token for a private dataset. Never PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_ALLOW_DEMO_FALLBACK=false
# Optional server-side deployment reporting endpoint (public URL, not a token).
DEPLOYMENT_REPORT_URL=
